# ============================================================
# CekKontrak Environment Configuration
# ============================================================

# LLM Providers
# 1. Gemini (Primary) - https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Dipakai otomatis bila model utama sibuk (503) atau kena limit (429)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# 2. Groq (Fallback) - https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Supabase (Optional for user auth & cloud storage)
SUPABASE_URL=
SUPABASE_KEY=

# Local SQLite Database file
DATABASE_PATH=cekkontrak.db

# Limits
# Jumlah pasal per 1 request AI (kuota gratis Gemini ~5 request/menit)
LLM_BATCH_SIZE=15
MAX_FILE_SIZE_MB=10
MAX_PAGES=25
