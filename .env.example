# ============================================================
# CekKontrak Environment Configuration
# ============================================================

# LLM Providers
# 1. Gemini (Primary) - https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 2. Groq (Fallback) - https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase (Optional for user auth & cloud storage)
SUPABASE_URL=
SUPABASE_KEY=

# Local SQLite Database file
DATABASE_PATH=cekkontrak.db

# Limits
MAX_FILE_SIZE_MB=10
MAX_PAGES=25
